{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A streaming chat agent with one tool (web search) and time-aware memory of past conversations.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include .env --disable-warning=ExperimentalWarning src/main.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/main.ts",
    "seed": "tsx --disable-warning=ExperimentalWarning src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@hono/node-server": "^2.1.6",
    "chrono-node": "^2.10.3",
    "hono": "^4.13.17",
    "openai": "^7.55.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
