# ── LLM (set at least one) ─────────────────────────────────────────────
# Which provider the agent uses: "anthropic" or "openai".
# If unset, the first provider with a key wins (Anthropic first).
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (lower = faster first token)
ANTHROPIC_EFFORT=medium

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# none | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=low

# ── Web search (required: the agent's one tool) ───────────────────────
TAVILY_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────
PORT=3000
# SQLite file holding every conversation (created on first run)
DB_PATH=./data/minimi.db
# Time travel for testing memory, e.g. AGENT_NOW=2026-11-17T10:00:00
# The clock starts at this instant and keeps ticking. Uses the machine's time zone.
AGENT_NOW=
